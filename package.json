{
  "name": "chess-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "check": "biome check . && tsc -b",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "chess.js": "^1.4.0",
    "lucide-solid": "^1.72.0",
    "solid-js": "^1.9.19",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "^1.65.0",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.2.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^5.1.0"
  }
}
